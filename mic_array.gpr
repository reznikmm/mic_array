with "config/mic_array_config.gpr";

with "runtime_build.gpr";
with "ravenscar_build.gpr";

project Mic_Array is

   for Target use runtime_build'Target;
   for Runtime ("Ada") use runtime_build'Runtime ("Ada");

   for Library_Name use "mic_array";
   for Library_Version use Project'Library_Name & ".so." & Mic_Array_Config.Crate_Version;

   for Source_Dirs use ("source/", "config/");
   for Object_Dir use ".obj/" & Mic_Array_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use ".lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("MIC_ARRAY_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Mic_Array_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Linker is
     for Switches ("Ada") use Runtime_Build.Linker_Switches;
   end Linker;

   package Ide is
      for Program_Host use "localhost:4242";
      for Communication_Protocol use "remote";
      for Connection_Tool use "st-util";
   end Ide;

end Mic_Array;
